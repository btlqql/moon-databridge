  {
    "name": "followup composite eligibility",
    "request": {
      "rows": [
        {
          "n": 1,
          "kind": "a"
        },
        {
          "n": 2,
          "kind": "b"
        },
        {
          "n": 3,
          "kind": "a"
        }
      ],
      "filter": {
        "all": [
          {
            "field": "n",
            "op": "ge",
            "value": 2
          },
          {
            "not": {
              "field": "kind",
              "value": "b"
            }
          }
        ]
      }
    },
    "expected": {
      "rows": [
        {
          "n": 3,
          "kind": "a"
        }
      ],
      "audit/filtered": 2
    },
    "error": false
  },
