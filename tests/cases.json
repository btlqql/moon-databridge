[
  {
    "name": "quoted multiline CSV",
    "request": {
      "format": "csv",
      "text": "id,note\r\n1,\"a,b\"\r\n2,\"line1\nline2\"\r\n"
    },
    "expected": {
      "rows/0/note": "a,b",
      "rows/1/note": "line1\nline2",
      "input_records": 2
    },
    "error": false
  },
  {
    "name": "typed quarantine",
    "request": {
      "rows": [
        {
          "n": "7"
        },
        {
          "n": "bad"
        },
        {}
      ],
      "columns": [
        {
          "source": "n",
          "type": "integer",
          "required": true
        }
      ]
    },
    "expected": {
      "rows/0/n": 7,
      "accepted_before_operations": 1,
      "input_records": 3
    },
    "error": false
  },
  {
    "name": "join filter deduplicate",
    "request": {
      "rows": [
        {
          "id": 1,
          "n": 3
        },
        {
          "id": 1,
          "n": 3
        },
        {
          "id": 2,
          "n": 0
        }
      ],
      "filter": {
        "field": "n",
        "op": "gt",
        "value": 1
      },
      "deduplicate": [
        "id"
      ],
      "join": {
        "rows": [
          {
            "key": 1,
            "name": "alpha"
          }
        ],
        "left_key": "id",
        "right_key": "key"
      }
    },
    "expected": {
      "deduplicated": 1,
      "rows/0/right_name": "alpha"
    },
    "error": false
  },
  {
    "name": "group sum mean",
    "request": {
      "rows": [
        {
          "g": "a",
          "n": 2
        },
        {
          "g": "a",
          "n": 4
        }
      ],
      "group": {
        "keys": [
          "g"
        ],
        "value": "n"
      }
    },
    "expected": {
      "rows/0/sum": 6,
      "rows/0/mean": 3,
      "rows/0/count": 2
    },
    "error": false
  },
  {
    "name": "JSONL reconciliation",
    "request": {
      "format": "jsonl",
      "text": "{\"n\":1}\nbad\n{\"n\":2}"
    },
    "expected": {
      "input_records": 3,
      "accepted_before_operations": 2
    },
    "error": false
  },
  {
    "name": "duplicate header",
    "request": {
      "format": "csv",
      "text": "n,n\n1,2"
    },
    "expected": {},
    "error": true
  },
  {
    "name": "unclosed quote",
    "request": {
      "format": "csv",
      "text": "n\n\"x"
    },
    "expected": {},
    "error": true
  },
  {
    "name": "join duplicates forbidden",
    "request": {
      "rows": [
        {
          "id": 1
        }
      ],
      "join": {
        "rows": [
          {
            "id": 1
          },
          {
            "id": 1
          }
        ],
        "left_key": "id",
        "right_key": "id"
      }
    },
    "expected": {},
    "error": true
  },
  {
    "name": "reconcile every pipeline stage",
    "request": {
      "rows": [
        {
          "id": "a",
          "n": "2"
        },
        {
          "id": "a",
          "n": "2"
        },
        {
          "id": "b",
          "n": "0"
        },
        {
          "id": "c",
          "n": "bad"
        },
        {
          "id": "d",
          "n": "4"
        }
      ],
      "columns": [
        {
          "source": "id",
          "type": "string"
        },
        {
          "source": "n",
          "type": "number",
          "required": true
        }
      ],
      "filter": {
        "field": "n",
        "op": "gt",
        "value": 1
      },
      "deduplicate": [
        "id"
      ],
      "join": {
        "rows": [
          {
            "id": "a",
            "category": "x"
          }
        ],
        "left_key": "id",
        "right_key": "id",
        "inner": true
      },
      "group": {
        "keys": [],
        "value": "n"
      },
      "quality_gate": {
        "max_rejected": 0,
        "max_rejection_fraction": 0.1
      }
    },
    "expected": {
      "audit": {
        "input": 5,
        "rejected": 1,
        "accepted": 4,
        "filtered": 1,
        "deduplicated": 1,
        "join_discarded": 1,
        "before_group": 1,
        "returned": 1,
        "conserved": true
      },
      "quality_gate/passed": false,
      "quality_gate/violations": [
        "max_rejected",
        "max_rejection_fraction"
      ],
      "rows/0/sum": 2
    },
    "error": false
  },
  {
    "name": "quality threshold equality",
    "request": {
      "format": "jsonl",
      "text": "{\"n\":1}\nbad\n{\"n\":2}",
      "quality_gate": {
        "max_rejected": 1,
        "max_rejection_fraction": 0.5
      }
    },
    "expected": {
      "audit/input": 3,
      "audit/rejected": 1,
      "quality_gate/passed": true
    },
    "error": false
  },
  {
    "name": "empty quality denominator",
    "request": {
      "rows": [],
      "quality_gate": {
        "max_rejected": 0,
        "max_rejection_fraction": 0
      }
    },
    "expected": {
      "quality_gate/passed": true,
      "quality_gate/rejection_fraction": 0,
      "audit/conserved": true
    },
    "error": false
  },
  {
