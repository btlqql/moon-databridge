[
  {
    "name": "quoted multiline CSV",
    "request": {
      "format": "csv",
      "text": "id,note\r\n1,\"a,b\"\r\n2,\"line1\nline2\"\r\n"
    },
    "expected": {
      "rows/0/note": "a,b",
      "rows/1/note": "line1\nline2",
      "input_records": 2
    },
    "error": false
  },
  {
    "name": "typed quarantine",
    "request": {
      "rows": [
        {
          "n": "7"
        },
        {
          "n": "bad"
        },
        {}
      ],
      "columns": [
        {
          "source": "n",
          "type": "integer",
          "required": true
        }
      ]
    },
    "expected": {
      "rows/0/n": 7,
      "accepted_before_operations": 1,
      "input_records": 3
    },
    "error": false
  },
  {
    "name": "join filter deduplicate",
    "request": {
      "rows": [
        {
          "id": 1,
          "n": 3
        },
        {
          "id": 1,
          "n": 3
        },
        {
          "id": 2,
          "n": 0
        }
      ],
      "filter": {
        "field": "n",
        "op": "gt",
        "value": 1
      },
      "deduplicate": [
        "id"
      ],
      "join": {
        "rows": [
          {
            "key": 1,
            "name": "alpha"
          }
        ],
        "left_key": "id",
        "right_key": "key"
      }
    },
    "expected": {
      "deduplicated": 1,
      "rows/0/right_name": "alpha"
    },
    "error": false
  },
  {
    "name": "group sum mean",
    "request": {
      "rows": [
        {
          "g": "a",
          "n": 2
        },
        {
          "g": "a",
          "n": 4
        }
      ],
      "group": {
        "keys": [
          "g"
        ],
        "value": "n"
      }
    },
    "expected": {
      "rows/0/sum": 6,
      "rows/0/mean": 3,
      "rows/0/count": 2
    },
    "error": false
  },
  {
    "name": "JSONL reconciliation",
    "request": {
      "format": "jsonl",
      "text": "{\"n\":1}\nbad\n{\"n\":2}"
    },
    "expected": {
      "input_records": 3,
      "accepted_before_operations": 2
    },
    "error": false
  },
  {
    "name": "duplicate header",
    "request": {
      "format": "csv",
      "text": "n,n\n1,2"
    },
    "expected": {},
    "error": true
  },
  {
    "name": "unclosed quote",
    "request": {
      "format": "csv",
      "text": "n\n\"x"
    },
    "expected": {},
    "error": true
  },
  {
    "name": "join duplicates forbidden",
    "request": {
      "rows": [
        {
          "id": 1
        }
      ],
      "join": {
        "rows": [
          {
            "id": 1
          },
          {
            "id": 1
          }
        ],
        "left_key": "id",
        "right_key": "id"
      }
    },
    "expected": {},
    "error": true
  }
]
